DB_HOST=db
DB_PORT=5432
DB_NAME=vinbot
DB_USER=postgres
DB_PASSWORD=changeme

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clé de chiffrement au repos des sessions Vinted (changer en prod)
SESSION_ENCRYPTION_KEY=change-moi

# Endpoint CDP (Chrome DevTools Protocol) du sidecar connect-browser.
# Accès via le réseau Docker uniquement (port 9222 non publié). Scheme http.
CDP_URL=http://connect-browser:9222

# URL noVNC embarquée dans l'iframe du dashboard (bakée au build Next.js).
# Adapter l'IP à celle de la VM (même IP que NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_NOVNC_URL=http://192.168.0.40:6080/vnc.html?autoconnect=1&resize=scale
